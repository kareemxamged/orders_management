# ==============================================
# متغيرات البيئة لنظام إدارة الطلبات
# ==============================================

# Supabase Configuration
# احصل على هذه القيم من لوحة تحكم Supabase > Settings > API
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Configuration
VITE_APP_NAME=نظام إدارة الطلبات
VITE_APP_VERSION=1.0.0

# ==============================================
# تعليمات الإعداد:
# ==============================================
# 1. انسخ هذا الملف إلى .env
# 2. استبدل القيم أعلاه بالقيم الصحيحة من Supabase
# 3. احتفظ بهذا الملف آمناً ولا ترفعه إلى Git

